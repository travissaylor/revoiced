---
interface Props {
  title?: string;
}

const { title = 'Revoiced' } = Astro.props;
const pageTitle = title === 'Revoiced' ? title : `${title} — Revoiced`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="site-name">Revoiced</a>
        <nav class="site-nav">
          <a href="/author">Authors</a>
          <a href="/genre">Genres</a>
          <a href="/recent">Recent</a>
        </nav>
        <div class="search-bar">
          <input type="search" placeholder="Search summaries…" disabled aria-label="Search summaries" />
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>Revoiced — books re-told in the author's voice</p>
    </footer>
  </body>
</html>

<style is:global>
  /* ── CSS Custom Properties for Light / Dark theming ── */
  :root {
    --color-bg: #faf9f6;
    --color-surface: #ffffff;
    --color-text: #1a1a1a;
    --color-text-muted: #555555;
    --color-heading: #111111;
    --color-link: #7b4b2a;
    --color-link-hover: #5a3520;
    --color-border: #e0dcd4;
    --color-header-bg: #f0ede6;
    --color-footer-bg: #f0ede6;
    --color-search-bg: #ffffff;
    --color-search-border: #ccc8be;
    --color-search-placeholder: #999;

    --font-body: Georgia, 'Times New Roman', serif;
    --font-heading: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    --font-mono: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;

    --measure: 65ch;
    --space-xs: 0.25rem;
    --space-sm: 0.5rem;
    --space-md: 1rem;
    --space-lg: 2rem;
    --space-xl: 3rem;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-bg: #1a1a1a;
      --color-surface: #242424;
      --color-text: #e0dcd4;
      --color-text-muted: #a09a90;
      --color-heading: #f0ede6;
      --color-link: #d4a574;
      --color-link-hover: #e8c4a0;
      --color-border: #3a3a3a;
      --color-header-bg: #222222;
      --color-footer-bg: #222222;
      --color-search-bg: #2a2a2a;
      --color-search-border: #444444;
      --color-search-placeholder: #777;
    }
  }

  /* ── Reset ── */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* ── Base typography ── */
  html {
    font-size: 100%;
    -webkit-text-size-adjust: 100%;
  }

  body {
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text);
    background-color: var(--color-bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    color: var(--color-heading);
    line-height: 1.3;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  h1 { font-size: 2rem; }
  h2 { font-size: 1.5rem; }
  h3 { font-size: 1.25rem; }

  p {
    margin-bottom: 1em;
    max-width: var(--measure);
  }

  a {
    color: var(--color-link);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-link-hover);
    text-decoration: underline;
  }

  /* ── Site header ── */
  .site-header {
    background-color: var(--color-header-bg);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-md) var(--space-lg);
  }

  .header-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .site-name {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-heading);
    text-decoration: none;
  }

  .site-name:hover {
    color: var(--color-link);
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    gap: var(--space-md);
  }

  .site-nav a {
    font-family: var(--font-heading);
    font-size: 0.95rem;
  }

  .search-bar {
    margin-left: auto;
  }

  .search-bar input {
    font-family: var(--font-body);
    font-size: 0.9rem;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-search-border);
    border-radius: 4px;
    background: var(--color-search-bg);
    color: var(--color-text);
    width: 14rem;
  }

  .search-bar input::placeholder {
    color: var(--color-search-placeholder);
  }

  /* ── Main content ── */
  main {
    flex: 1;
    max-width: 72rem;
    width: 100%;
    margin: 0 auto;
    padding: var(--space-lg);
  }

  /* ── Site footer ── */
  .site-footer {
    background-color: var(--color-footer-bg);
    border-top: 1px solid var(--color-border);
    padding: var(--space-md) var(--space-lg);
    text-align: center;
  }

  .site-footer p {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0 auto;
  }
</style>
