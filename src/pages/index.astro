---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookList from '../components/BookList.astro';
import { getBooks, groupBy, plural } from '../lib/books';

const books = await getBooks();
const authors = groupBy(books, 'author');
const recent = [...books].sort((a, b) => b.added.getTime() - a.added.getTime()).slice(0, 3);
const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <section class="page-head">
    <h1>Great books, retold in their authors’ own voices.</h1>
    <p>{plural(books.length, 'summary', 'summaries')} from {plural(authors.length, 'author')}. Each one runs about twenty minutes.</p>
  </section>

  <section class="recent" aria-labelledby="recent-label">
    <div class="section-row">
      <h2 class="section-label" id="recent-label">Recently added</h2>
      <a href={`${base}recent/`} class="more">See all</a>
    </div>
    <BookList books={recent} />
  </section>

  <section class="library" aria-labelledby="library-label">
    <div class="section-row">
      <h2 class="section-label" id="library-label">The library</h2>
    </div>
    <label class="filter">
      <span class="visually-hidden">Filter by title, author, or genre</span>
      <input type="search" id="filter" placeholder="Filter by title, author, or genre" autocomplete="off" />
    </label>

    {authors.map((group) => (
      <div class="author-group" data-group>
        <h3 class="author-name">
          <a href={`${base}author/${group.slug}/`}>{group.name}</a>
        </h3>
        <BookList books={group.books} hide={['author']} />
      </div>
    ))}
    <p class="empty" id="filter-empty" hidden>
      No titles match. <button type="button" data-search-open>Search the full text instead</button>
    </p>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('filter') as HTMLInputElement;
  const groups = document.querySelectorAll<HTMLElement>('[data-group]');
  const empty = document.getElementById('filter-empty')!;

  function apply() {
    const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    groups.forEach((group) => {
      let groupShown = 0;
      group.querySelectorAll<HTMLElement>('li[data-search]').forEach((li) => {
        const match = terms.every((t) => li.dataset.search!.includes(t));
        li.hidden = !match;
        if (match) groupShown++;
      });
      group.hidden = groupShown === 0;
      shown += groupShown;
    });
    empty.hidden = shown > 0;
  }

  input.addEventListener('input', apply);
  apply();
</script>

<style>
  .page-head h1 {
    max-width: 18ch;
  }

  .recent {
    margin-bottom: 3.5rem;
  }

  .section-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .more {
    font-size: 0.85rem;
  }

  .filter input {
    width: 100%;
    font: inherit;
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 0.6rem 0.85rem;
    margin-bottom: 1.5rem;
  }

  .filter input::placeholder {
    color: var(--muted);
  }

  .filter input:focus {
    outline: none;
    border-color: var(--accent);
  }

  .author-group {
    margin-bottom: 2.25rem;
  }

  .author-name {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .author-name a {
    color: var(--ink);
  }

  .author-name a:hover {
    color: var(--accent);
  }

  .empty {
    color: var(--muted);
  }

  .empty button {
    font: inherit;
    color: var(--accent);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
