---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookList from '../../components/BookList.astro';
import { getBooks, groupBy, plural, type Group } from '../../lib/books';

export async function getStaticPaths() {
  return groupBy(await getBooks(), 'author').map((group) => ({
    params: { author: group.slug },
    props: { group },
  }));
}

const { group } = Astro.props as { group: Group };
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={group.name}>
  <section class="page-head">
    <a href={`${base}author/`} class="section-label crumb">Authors</a>
    <h1>{group.name}</h1>
    <p>{plural(group.books.length, 'summary', 'summaries')}</p>
  </section>
  <BookList books={group.books} hide={['author']} />
</BaseLayout>

<style>
  .crumb {
    display: inline-block;
  }
</style>
