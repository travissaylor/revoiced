---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GroupList from '../../components/GroupList.astro';
import { getBooks, groupBy, plural } from '../../lib/books';

const genres = groupBy(await getBooks(), 'genre');
---

<BaseLayout title="Genres">
  <section class="page-head">
    <h1>Genres</h1>
    <p>{plural(genres.length, 'genre')}.</p>
  </section>
  <GroupList groups={genres} path="genre" />
</BaseLayout>
