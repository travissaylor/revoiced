{
  "name": "static-summary-browser",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "generate-icons": "node scripts/generate-icons.mjs",
    "generate-audio": "node --env-file-if-exists=.env scripts/generate-audio.mjs",
    "build": "node scripts/generate-icons.mjs && astro build && pagefind --site dist",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "astro check",
    "validate": "node scripts/validate-content.mjs",
    "test": "node --experimental-strip-types --test \"scripts/**/*.test.mjs\" \"tests/*.test.mjs\"",
    "check-links": "node scripts/check-links.mjs",
    "check": "pnpm typecheck && pnpm validate && pnpm test && pnpm build && pnpm check-links"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "pagefind": "^1.5.2",
    "yaml": "^2.9.1"
  }
}
