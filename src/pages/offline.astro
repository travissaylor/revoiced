---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Offline">
  <section class="page-head" data-pagefind-ignore>
    <h1>You’re offline</h1>
    <p>This page hasn’t been saved for offline reading yet. Summaries you’ve opened before are still available.</p>
    <p class="actions">
      <a href={base}>Go to the library</a>
      <a href="javascript:history.back()">Go back</a>
    </p>
  </section>
</BaseLayout>

<style>
  .actions {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
</style>
