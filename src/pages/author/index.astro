---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GroupList from '../../components/GroupList.astro';
import { getBooks, groupBy, plural } from '../../lib/books';

const books = await getBooks();
const authors = groupBy(books, 'author');
---

<BaseLayout title="Authors">
  <section class="page-head">
    <h1>Authors</h1>
    <p>{plural(authors.length, 'author')}, {plural(books.length, 'summary', 'summaries')}.</p>
  </section>
  <GroupList groups={authors} path="author" />
</BaseLayout>
