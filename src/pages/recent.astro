---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const summaries = await getCollection('summaries');
const sorted = summaries.sort(
  (a, b) => b.data.summary_generated.getTime() - a.data.summary_generated.getTime()
);
---

<BaseLayout title="Recently Added">
  <h1>Recently Added</h1>
  <ul class="recent-list">
    {sorted.map((entry) => (
      <li class="recent-card">
        <a href={`/${entry.id}`}>
          <span class="card-date">
            {entry.data.summary_generated.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </span>
          <span class="card-title">{entry.data.title}</span>
          <span class="card-meta">
            {entry.data.author} &middot; {entry.data.genre} &middot; {entry.data.publication_year}
          </span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .recent-list {
    list-style: none;
    padding: 0;
    margin: var(--space-lg) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .recent-card a {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .recent-card a:hover {
    border-color: var(--color-link);
    text-decoration: none;
  }

  .card-date {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-heading);
  }

  .card-meta {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
</style>
