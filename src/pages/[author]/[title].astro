---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookList from '../../components/BookList.astro';
import { getBooks, type Book } from '../../lib/books';

export async function getStaticPaths() {
  const books = await getBooks();
  return books.map((book) => {
    const others = books.filter((b) => b.id !== book.id);
    const byAuthor = others.filter((b) => b.authorSlug === book.authorSlug);
    const byGenre = others.filter((b) => b.genreSlug === book.genreSlug);
    const [author, title] = book.id.split('/');
    return {
      params: { author, title },
      props: {
        book,
        related: byAuthor.length ? byAuthor : byGenre.length ? byGenre : others.slice(0, 3),
        relatedLabel: byAuthor.length
          ? `More by ${book.author}`
          : byGenre.length
            ? `More ${book.genre.toLowerCase()}`
            : 'Keep reading',
      },
    };
  });
}

interface Props {
  book: Book;
  related: Book[];
  relatedLabel: string;
}

const { book, related, relatedLabel } = Astro.props;
const { Content } = await render(book.entry);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${book.title} by ${book.author}`} description={`A summary of ${book.title}, retold in the voice of ${book.author}.`}>
  <div class="progress" id="progress" aria-hidden="true"></div>

  <article class="summary">
    <header class="summary-head">
      <p class="kicker">
        <a href={`${base}genre/${book.genreSlug}/`}>{book.genre}</a>
        <span>{book.year}</span>
      </p>
      <h1 data-pagefind-weight="10" data-pagefind-meta="title">{book.title}</h1>
      <p class="byline">
        by <a href={`${base}author/${book.authorSlug}/`} data-pagefind-weight="10" data-pagefind-meta="author">{book.author}</a>
      </p>
      <p class="reading-time">{book.minutes} min read{book.hasAudio && ' · Audio available'}</p>
    </header>

    {book.hasAudio && (
      <div class="player" id="player" data-pagefind-ignore>
        <span class="player-label">Listen</span>
        <audio controls preload="metadata" src={book.audioUrl}></audio>
      </div>
    )}

    <div class="prose" data-pagefind-body>
      <Content />
    </div>

    <hr class="fin" />
  </article>

  {related.length > 0 && (
    <aside class="related" data-pagefind-ignore>
      <h2 class="section-label">{relatedLabel}</h2>
      <BookList books={related} hide={relatedLabel.startsWith('More by') ? ['author'] : []} />
    </aside>
  )}

  <button type="button" class="resume" id="resume" hidden data-pagefind-ignore>Resume reading</button>
</BaseLayout>

<script>
  const bar = document.getElementById('progress')!;
  const resume = document.getElementById('resume')!;
  const key = `revoiced:pos:${location.pathname}`;

  function ratio() {
    const max = document.documentElement.scrollHeight - innerHeight;
    return max > 0 ? Math.min(scrollY / max, 1) : 0;
  }

  let saveTimer: number | undefined;
  function onScroll() {
    const r = ratio();
    bar.style.transform = `scaleX(${r})`;
    if (r > 0.05) resume.hidden = true;
    clearTimeout(saveTimer);
    saveTimer = window.setTimeout(() => {
      if (r > 0.97) localStorage.removeItem(key);
      else if (r > 0.03) localStorage.setItem(key, String(r));
    }, 300);
  }

  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const saved = Number(localStorage.getItem(key));
  if (saved > 0.03 && ratio() < 0.01) {
    resume.textContent = `Resume reading · ${Math.round(saved * 100)}%`;
    resume.hidden = false;
    resume.addEventListener('click', () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      scrollTo({ top: saved * max, behavior: 'smooth' });
      resume.hidden = true;
    });
  }

  // Keep the player in view while audio is playing.
  const player = document.getElementById('player');
  const audio = player?.querySelector('audio');
  if (player && audio) {
    audio.addEventListener('play', () => player.classList.add('is-playing'));
    audio.addEventListener('pause', () => player.classList.remove('is-playing'));
  }
</script>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    z-index: 20;
  }

  .summary-head {
    margin-bottom: 2.5rem;
  }

  .kicker {
    display: flex;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .kicker span::before {
    content: '·';
    margin-right: 0.5rem;
  }

  .summary-head h1 {
    margin-top: 0.75rem;
    font-size: clamp(2.25rem, 7vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .byline {
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-style: italic;
    color: var(--muted);
  }

  .byline a {
    color: var(--ink);
  }

  .byline a:hover {
    color: var(--accent);
  }

  .reading-time {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.85rem;
    color: var(--muted);
  }

  .player {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
    padding: 0.6rem 0.6rem 0.6rem 1rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 999px;
    z-index: 10;
  }

  .player.is-playing {
    position: sticky;
    top: 0.75rem;
    box-shadow: 0 8px 24px -12px rgb(0 0 0 / 0.25);
  }

  .player-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .player audio {
    flex: 1;
    min-width: 0;
    height: 2.25rem;
  }

  @media (max-width: 560px) {
    .player { padding: 0.35rem; }
    .player-label { display: none; }
  }

  .prose {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.25rem);
    line-height: 1.7;
    color: var(--text);
    max-width: 33em;
    hyphens: auto;
    hanging-punctuation: first;
  }

  .prose :global(p) {
    text-wrap: pretty;
  }

  .prose :global(p + p) {
    margin-top: 1.1em;
  }

  .prose > :global(p:first-child::first-letter) {
    float: left;
    font-size: 3.4em;
    line-height: 0.85;
    padding: 0.08em 0.1em 0 0;
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin: 2em 0 0.6em;
  }

  .prose :global(blockquote) {
    margin: 1.5em 0;
    padding-left: 1em;
    border-left: 2px solid var(--rule);
    font-style: italic;
  }

  .prose :global(hr) {
    border: none;
    margin: 2.5em 0;
    text-align: center;
  }

  .prose :global(hr)::after {
    content: '* * *';
    letter-spacing: 0.5em;
    color: var(--muted);
  }

  .fin {
    width: 3rem;
    margin: 3.5rem auto 4rem;
    border: none;
    border-top: 1px solid var(--muted);
  }

  .related {
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .resume {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    font: inherit;
    font-size: 0.9rem;
    color: var(--paper);
    background: var(--ink);
    border: none;
    border-radius: 999px;
    padding: 0.6rem 1.1rem;
    cursor: pointer;
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.4);
  }
</style>
