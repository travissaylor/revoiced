---
import type { Group } from '../lib/books';

interface Props {
  groups: Group[];
  path: 'author' | 'genre';
}

const { groups, path } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ul class="group-list">
  {groups.map((group) => (
    <li>
      <a href={`${base}${path}/${group.slug}/`}>
        <span class="name">{group.name}</span>
        <span class="titles">{group.books.map((b) => b.title).join(', ')}</span>
        <span class="count">{group.books.length}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .group-list {
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--rule);
    color: inherit;
  }

  .name {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--ink);
    transition: color 0.15s ease;
  }

  a:hover .name {
    color: var(--accent);
  }

  .titles {
    grid-row: 2;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .count {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
</style>
